# ============================================================================
# Copy to .env and fill in your own values. .env itself is never committed.
# ============================================================================

# ---------- Site ----------
SITE_URL=https://your-site.example.com
# Path to publisher.php on the site (random name, changed at every deploy)
PUBLISHER_PATH=/pub-xxxxxxxxxxxx.php
# Shared secret for publisher.php. Generate: python -c "import secrets;print(secrets.token_hex(24))"
PUBLISHER_TOKEN=change-me-to-a-long-random-string

# ---------- FTP (deploy of publisher.php, backups) ----------
FTP_HOST=ftp.your-site.example.com
FTP_PORT=21
FTP_USER=your-ftp-user
FTP_PASSWORD=change-me
# Web root inside the FTP account
FTP_SITE_PATH=www/your-site.example.com

# ---------- Optional HTTP Basic auth in front of /admin/ ----------
ALERT_LOGIN=
ALERT_PASSWORD=

# ---------- Diafan admin (only for manual checks; not used by the pipeline) ----------
ADMIN_URL=https://your-site.example.com/admin/
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ---------- MySQL ----------
# The publisher runs on the server and takes credentials from the site's own
# config.php, so these are informational: needed only for manual DB work.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------- LLM ----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Local model instead of the API (writer.py --provider ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# ---------- Images (optional, only for the Pexels provider) ----------
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------- Yandex.Webmaster: recrawl of new URLs after publishing ----------
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_HOST=your-site.example.com
